        { pergunta: "Como se diz 'Cabeça' em inglês?", opcoes: ["Head", "Hair", "Face", "Neck"], correta: "Head", dica: "Onde fica o cérebro, os olhos e o cabelo." },
        { pergunta: "Qual o significado de 'Hair'?", opcoes: ["Olho", "Cabelo", "Orelha", "Nariz"], correta: "Hair", dica: "Cresce no topo da cabeça." },
        { pergunta: "Como se diz 'Olho' em inglês?", opcoes: ["Ear", "Nose", "Eye", "Mouth"], correta: "Eye", dica: "Órgão da visão. Pronuncia-se igual à letra 'I'." },
        { pergunta: "O que significa 'Mouth'?", opcoes: ["Nariz", "Boca", "Dente", "Língua"], correta: "Mouth", dica: "Parte do rosto usada para falar e comer." },
        { pergunta: "Como se diz 'Sorvete' em inglês?", opcoes: ["Cake", "Chocolate", "Ice cream", "Candy"], correta: "Ice cream", dica: "Sobremesa gelada de massa." },
        { pergunta: "Qual o significado do adjetivo 'Rich'?", opcoes: ["Pobre", "Rico", "Forte", "Fraco"], correta: "Rich", dica: "Quem tem muito dinheiro." },
        { pergunta: "Como se diz 'Pobre' em inglês?", opcoes: ["Rich", "Poor", "Cheap", "Expensive"], correta: "Poor", dica: "O oposto de 'rich'." },
        { pergunta: "O que significa 'Cheap'?", opcoes: ["Caro", "Barato", "Pesado", "Leve"], correta: "Cheap", dica: "Algo que custa pouco dinheiro." },
        { pergunta: "Como se diz 'Caro' (custo alto) em inglês?", opcoes: ["Cheap", "Free", "Expensive", "Large"], correta: "Expensive", dica: "O oposto de 'cheap'." },
        { pergunta: "Qual o significado de 'Store'?", opcoes: ["Escola", "Loja", "Praia", "Parque"], correta: "Store", dica: "Estabelecimento comercial onde compramos coisas." },
        { pergunta: "Como se diz 'Comprar' em inglês?", opcoes: ["Sell", "Buy", "Pay", "Cost"], correta: "Buy", dica: "Ação de adquirir um produto pagando por ele." },
        { pergunta: "O que significa o verbo 'To Sell'?", opcoes: ["Comprar", "Vender", "Alugar", "Trocar"], correta: "To Sell", dica: "O oposto de 'buy'." },
        { pergunta: "Como se diz 'Cachorro-quente' em inglês?", opcoes: ["Hamburger", "Hot dog", "Sandwich", "Pizza"], correta: "Hot dog", dica: "A tradução literal é exatamente o nome do prato." },
        { pergunta: "Qual o significado de 'Milkshake'?", opcoes: ["Suco de fruta", "Bebida de leite batido", "Café gelado", "Chá"], correta: "Milkshake", dica: "Leite batido geralmente com sorvete e calda." },
        { pergunta: "Como se diz 'Bicicleta' em inglês?", opcoes: ["Car", "Motorcycle", "Bicycle / Bike", "Bus"], correta: "Bicycle / Bike", dica: "Veículo de duas rodas movido a pedal." },
        { pergunta: "O que significa 'Bus'?", opcoes: ["Trem", "Ônibus", "Metrô", "Táxi"], correta: "Bus", dica: "Transporte público coletivo grande." },
        { pergunta: "Qual o plural irregular de 'Mouse' (camundongo)?", opcoes: ["Mouses", "Mice", "Mices", "Mousen"], correta: "Mice", dica: "Plural irregular completo; vira outra palavra curta." }
    ];

    let perguntasSessao = [];
    let indiceAtual = 0;
    let pontuacao = 0;
    let dicasRestantes = 3;
    
    let tempoInicio;
    let intervaloTimer;
    const TOTAL_QUESTOES_SESSAO = 10;

    const questionText = document.getElementById('question-text');
    const optionsBox = document.getElementById('options-box');
    const hintBox = document.getElementById('hint-box');
    const hintBtn = document.getElementById('hint-btn');
    const scoreText = document.getElementById('score-text');
    const progressText = document.getElementById('progress-text');
    const timerText = document.getElementById('timer-text');
    const bgMusic = document.getElementById('bg-music');
    const audioSource = document.getElementById('audio-source');

    function embaralhar(array) {
        for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
    }

    function iniciarMusica() {
        bgMusic.play().catch(() => {
            document.addEventListener('click', () => {
                bgMusic.play();
            }, { once: true });
        });
    }

    function mudarMusicaEspecifica(urlMusica) {
        bgMusic.pause();
        audioSource.src = urlMusica;
        bgMusic.load();
        bgMusic.play().catch(err => console.log("Aguardando clique do usuário para áudio."));
    }

    function inicializarSessao() {
        iniciarMusica();
        
        let todasEmbaralhadas = embaralhar([...bancoPerguntas]);
        perguntasSessao = todasEmbaralhadas.slice(0, TOTAL_QUESTOES_SESSAO);
        
        indiceAtual = 0;
        pontuacao = 0;
        dicasRestantes = 3;
        
        scoreText.innerText = `Pontuação: 0`;
        hintBtn.innerText = `💡 Precisa de uma dica? (Restam 3)`;
        hintBtn.disabled = false;
        
        tempoInicio = Date.now();
        clearInterval(intervaloTimer);
        intervaloTimer = setInterval(atualizarTimer, 1000);

        loadQuestion();
    }

    function atualizarTimer() {
        let tempoDecorrido = Math.floor((Date.now() - tempoInicio) / 1000);
        let minutos = Math.floor(tempoDecorrido / 60).toString().padStart(2, '0');
        let segundos = (tempoDecorrido % 60).toString().padStart(2, '0');
        timerText.innerText = `Tempo: ${minutos}:${segundos}`;
    }

    function loadQuestion() {
        hintBox.style.display = 'none'; 
        
        if (indiceAtual < perguntasSessao.length) {
            const dados = perguntasSessao[indiceAtual];
            questionText.innerHTML = `Questão ${indiceAtual + 1}:<br>${dados.pergunta}`;
            hintBox.innerText = dados.dica;
            optionsBox.innerHTML = '';
            progressText.innerText = `Pergunta: ${indiceAtual + 1}/${TOTAL_QUESTOES_SESSAO}`;

            const oEmbaralhadas = embaralhar([...dados.opcoes]);
            oEmbaralhadas.forEach(opcao => {
                const button = document.createElement('button');
                button.innerText = opcao;
                button.classList.add('btn-option');
                button.onclick = () => checkAnswer(button, opcao, dados.correta);
                optionsBox.appendChild(button);
            });
        } else {
            showResults();
        }
    }

    function checkAnswer(button, selected, correct) {
        const buttons = optionsBox.querySelectorAll('.btn-option');
        buttons.forEach(btn => btn.disabled = true);

        if (selected === correct) {
            button.classList.add('correct');
            pontuacao++;
            scoreText.innerText = `Pontuação: ${pontuacao}`;
        } else {
            button.classList.add('incorrect');
            buttons.forEach(btn => {
                if (btn.innerText === correct) btn.classList.add('correct');
            });
        }

        setTimeout(() => {
            indiceAtual++;
            loadQuestion();
        }, 1500);
    }

    function useHint() {
        if (dicasRestantes > 0) {
            if (hintBox.style.display === 'none' || hintBox.style.display === '') {
                hintBox.style.display = 'block';
                dicasRestantes--;
                hintBtn.innerText = `💡 Precisa de uma dica? (Restam ${dicasRestantes})`;
                if (dicasRestantes === 0) hintBtn.disabled = true;
            }
        }
    }

    function showResults() {
        clearInterval(intervaloTimer); 
        
        let tempoFinal = Math.floor((Date.now() - tempoInicio) / 1000);
        let minFinal = Math.floor(tempoFinal / 60);
        let segFinal = tempoFinal % 60;
        let tempoTexto = `${minFinal}min e ${segFinal}seg`;

        const quizContainer = document.getElementById('quiz');
        let feedback = "";
        
        if (pontuacao >= 8) feedback = "🏆 Excelente! Você dominou essa rodada!";
        else if (pontuacao >= 5) feedback = "👍 Muito bom! Seu inglês está progredindo bem.";
        else feedback = "📚 Treinar mais vai te ajudar! Vamos outra vez?";

        quizContainer.innerHTML = `
            <h2>🎉 Sessão Concluída!</h2>
            <p>${feedback}</p>
            <div style="background: #f8fafc; padding: 15px; border-radius: 8px; margin: 20px 0; border: 1px solid #e2e8f0;">
                <p style="margin: 5px 0;">🎯 <strong>Acertos:</strong> ${pontuacao} de ${TOTAL_QUESTOES_SESSAO} (${(pontuacao/TOTAL_QUESTOES_SESSAO)*100}%)</p>
                <p style="margin: 5px 0;">⏱️ <strong>Tempo total:</strong> ${tempoTexto}</p>
            </div>
            <button class="btn-option" style="width:100%; border-color: var(--primary-color); background: var(--primary-color); color: white;" onclick="window.location.reload()">
                Jogar Nova Sessão (Mais 10 Perguntas)
            </button>
        `;
    }

    inicializarSessao();
</script>

</body>
</html>
