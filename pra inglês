        { pergunta: "Como se diz 'Filha' em inglês?", opcoes: ["Son", "Daughter", "Children", "Girl"], correta: "Daughter", dica: "A descendente do sexo feminino." },
        { pergunta: "Qual o significado de 'Beautiful'?", opcoes: ["Feio", "Bonito", "Inteligente", "Alto"], correta: "Beautiful", dica: "Usado para elogiar a beleza de algo ou alguém." },
